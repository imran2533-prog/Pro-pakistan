# Gmail credentials for sending job applications
# EMAIL_USER = aapka Gmail address
# EMAIL_PASS = Gmail App Password (16-character code, normal password NAHI)
#
# App Password kaise banayein:
#   1. myaccount.google.com par jayen
#   2. Security > 2-Step Verification ON karein
#   3. Security > App passwords > Select app: Mail, Select device: Other
#   4. Generate karein — 16 character ka code milega
#   5. Woh code yahan paste karein (spaces ke bina)

EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
